rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is a manager
    function isManager() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }
    
    // Helper function to check if user is admin or manager
    function canManage() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager');
    }
    
    // Helper function to check if user is a resident
    function isResident() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'resident';
    }

    // Users collection
    match /users/{userId} {
      // Users can read and write their own data
      allow read, update: if isAuthenticated() && request.auth.uid == userId;
      
      // All authenticated users can read user profiles (needed for permission checks and user lookups)
      allow read: if isAuthenticated();
      
      // System can create users during signup/invitation flows
      allow create: if request.auth.uid == userId;
      
      // Admins and managers can manage users
      allow update, delete: if canManage();
    }
    
    // Tickets collection
    match /tickets/{ticketId} {
      // All authenticated users can read tickets (managers see all, residents filtered in app layer)
      allow read: if isAuthenticated();
      
      // All authenticated users can create tickets
      allow create: if isAuthenticated();
      
      // Ticket creator and managers can update tickets
      allow update: if isAuthenticated() && (
        resource.data.requestedBy == request.auth.uid ||
        canManage()
      );
      
      // Only managers can delete tickets
      allow delete: if canManage();
    }
    
    // Suppliers collection
    match /suppliers/{supplierId} {
      // All authenticated users can read suppliers
      allow read: if isAuthenticated();
      
      // Managers can manage suppliers
      allow create, update, delete: if canManage();
    }
    
    // Quotes collection
    match /quotes/{quoteId} {
      // Anyone authenticated can read quotes
      allow read: if isAuthenticated();
      
      // Anyone authenticated can create quotes
      allow create: if isAuthenticated();
      
      // Only managers can update and delete quotes
      allow update, delete: if isManager();
    }
    
    // Building events collection
    match /buildingEvents/{eventId} {
      // All authenticated users can read events
      allow read: if isAuthenticated();
      
      // Managers can create events
      allow create: if canManage();
      
      // Event assignees and managers can update events
      allow update: if isAuthenticated() && (
        resource.data.assignedTo[request.auth.uid] != null ||
        canManage()
      );
      
      // Only managers can delete events
      allow delete: if canManage();
    }
    
    // Budgets collection
    match /budgets/{budgetId} {
      // All authenticated users can read budgets
      allow read: if isAuthenticated();
      
      // Managers can create and update budgets
      allow create, update: if canManage();
      
      // Only admins can delete budgets
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Budget categories collection
    match /budgetCategories/{categoryId} {
      // Anyone authenticated can read budget categories
      allow read: if isAuthenticated();
      
      // Managers and admins can create and update budget categories
      allow create, update: if isManager() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // Only admins can delete budget categories
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Budget Category Masters collection
    match /budgetCategoryMasters/{categoryMasterId} {
      // All authenticated users can read budget category masters
      allow read: if isAuthenticated();
      
      // Managers can create and update category masters
      allow create, update: if canManage();
      
      // Only admins can delete category masters
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Expenses collection
    match /expenses/{expenseId} {
      // Only admins and managers can read expenses
      allow read: if canManage();
      
      // Only admins and managers can create and update expenses
      allow create, update: if canManage();
      
      // Only admins and managers can delete expenses
      allow delete: if canManage();
    }
    
    // Flats collection
    match /flats/{flatId} {
      // Admins and managers can read all flats
      // Residents can only read their own flat
      allow read: if isAuthenticated() && (
        canManage() ||
        (isResident() && flatId == get(/databases/$(database)/documents/people/$(request.auth.uid)).data.flatId)
      );
      
      // Only admins and managers can create and update flats
      allow create, update: if canManage();
      
      // Only admins and managers can delete flats
      allow delete: if canManage();
    }
    
    // Service Charge Demands collection
    match /serviceChargeDemands/{demandId} {
      // All authenticated users can read demands (residents filtered in app layer by flat)
      allow read: if isAuthenticated();
      
      // Only managers can create and update service charge demands
      allow create, update: if canManage();
      
      // Only managers can delete service charge demands
      allow delete: if canManage();
    }
    
    // Invoices collection
    match /invoices/{invoiceId} {
      // Anyone authenticated can read invoices
      allow read: if isAuthenticated();
      
      // Managers and finance users can create and update invoices
      allow create, update: if isManager() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'finance');
      
      // Only admins can delete invoices
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Buildings collection
    match /buildings/{buildingId} {
      // All authenticated users can read buildings
      allow read: if isAuthenticated();
      
      // Managers can create and update buildings
      allow create, update: if canManage();
      
      // Only admins can delete buildings
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Assets collection
    match /assets/{assetId} {
      // Anyone authenticated can read assets
      allow read: if isAuthenticated();
      
      // Managers and admins can create and update assets
      allow create, update: if isManager() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // Only admins can delete assets
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Meters collection
    match /meters/{meterId} {
      // Anyone authenticated can read meters
      allow read: if isAuthenticated();
      
      // Managers and admins can create and update meters
      allow create, update: if isManager() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // Only admins can delete meters
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Income collection
    match /income/{incomeId} {
      // All authenticated users can read income entries
      allow read: if isAuthenticated();
      
      // Managers and finance users can create and update income entries
      allow create, update: if canManage() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'finance');
      
      // Only admins can delete income entries
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Email logs collection
    match /emailLogs/{emailLogId} {
      // Managers can read email logs
      allow read: if canManage();
      
      // System can create email logs
      allow create: if isAuthenticated();
      
      // Managers can update and delete email logs
      allow update, delete: if canManage();
    }
    
    // Work orders collection
    match /workOrders/{workOrderId} {
      // All authenticated users can read work orders
      allow read: if isAuthenticated();
      
      // Managers can create and update work orders
      allow create, update: if canManage();
      
      // Managers can delete work orders
      allow delete: if canManage();
    }
    
    // Expenditure collection - NEW
    match /expenditure/{expenditureId} {
      // Anyone authenticated can read expenditure entries
      allow read: if isAuthenticated();
      
      // Managers and finance users can create and update expenditure entries
      allow create, update: if isManager() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'finance');
      
      // Only admins can delete expenditure entries
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    
    // Reminders collection - NEW
    match /reminders/{reminderId} {
      // Anyone authenticated can read reminders
      allow read: if isAuthenticated();
      
      // Managers and finance users can create and update reminders
      allow create, update: if isManager() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'finance');
      
      // Only admins can delete reminders
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    
    
    // People collection
    match /people/{personId} {
      // All authenticated users can read people
      allow read: if isAuthenticated();
      
      // Managers can create and update people
      allow create, update: if canManage();
      
      // Only managers can delete people
      allow delete: if canManage();
    }
    
    // Flat Ledger Transactions collection
    match /flatLedgerTransactions/{transactionId} {
      // All authenticated users can read flat ledger transactions
      allow read: if isAuthenticated();
      
      // Managers can create and update flat ledger transactions
      allow create, update: if canManage();
      
      // Only admins can delete flat ledger transactions
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Resident Account Ledgers collection
    match /residentAccountLedgers/{ledgerId} {
      // All authenticated users can read resident account ledgers
      allow read: if isAuthenticated();
      
      // Managers can create and update resident account ledgers
      allow create, update: if canManage();
      
      // Only admins can delete resident account ledgers
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Account Transactions collection
    match /accountTransactions/{transactionId} {
      // All authenticated users can read account transactions
      allow read: if isAuthenticated();
      
      // Managers can create and update account transactions
      allow create, update: if canManage();
      
      // Only admins can delete account transactions
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Invitations collection
    match /invitations/{invitationId} {
      // Managers can create invitations
      allow create: if canManage();
      
      // Public read access (needed for invitation acceptance page with secure token)
      allow read: if true;
      
      // Public update for accepting invitations (secure token validation happens in app)
      allow update: if true;
      
      // Only admins can delete invitations
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
  }
}
