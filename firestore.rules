rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is a manager
    function isManager() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager';
    }
    
    // Helper function to check if user is admin or manager
    function canManage() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager');
    }
    
    // Helper function to check if user is a resident
    function isResident() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'resident';
    }

    // Users collection
    match /users/{userId} {
      // Allow demo user creation without authentication (for testing)
      allow create: if true;
      
      // Users can read and write their own data
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      
      // TEMPORARILY RELAXED: Allow all authenticated users to read all users
      // (for User Management page and permission checks)
      // TODO: In production, restrict to admins/managers only
      allow read: if isAuthenticated();
      
      // Admins and managers can update/delete users
      allow update, delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager');
    }
    
    // Tickets collection - Role-based access
    match /tickets/{ticketId} {
      // Anyone authenticated can read tickets for now (will be restricted in production)
      // TODO: Restrict to ticket owner (requestedBy) and managers only
      allow read: if isAuthenticated();
      
      // Anyone authenticated can create tickets
      allow create: if isAuthenticated();
      
      // Anyone authenticated can update tickets for now (will be restricted in production)
      allow update: if isAuthenticated();
      
      // Only managers can delete tickets
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager');
    }
    
    // Suppliers collection - TEMPORARILY RELAXED FOR DEVELOPMENT
    match /suppliers/{supplierId} {
      // Allow read and create for development (will be restricted in production)
      allow read, create: if true;
      
      // Only managers can update and delete suppliers
      allow update, delete: if isManager();
    }
    
    // Quotes collection
    match /quotes/{quoteId} {
      // Anyone authenticated can read quotes
      allow read: if isAuthenticated();
      
      // Anyone authenticated can create quotes
      allow create: if isAuthenticated();
      
      // Only managers can update and delete quotes
      allow update, delete: if isManager();
    }
    
    // Building events collection
    match /buildingEvents/{eventId} {
      // Anyone authenticated can read events
      allow read: if isAuthenticated();
      
      // Anyone authenticated can create events (for testing)
      allow create: if isAuthenticated();
      
      // Users can update events they created, or managers can update any
      allow update: if isAuthenticated() && (
        resource.data.assignedTo[request.auth.uid] != null ||
        isManager()
      );
      
      // Only managers can delete events
      allow delete: if isManager();
    }
    
    // Budgets collection
    match /budgets/{budgetId} {
      // Anyone authenticated can read budgets
      allow read: if isAuthenticated();
      
      // TEMPORARILY RELAXED FOR DEVELOPMENT - Allow any authenticated user to create/update budgets
      allow create, update: if isAuthenticated();
      
      // Only admins can delete budgets
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Budget categories collection
    match /budgetCategories/{categoryId} {
      // Anyone authenticated can read budget categories
      allow read: if isAuthenticated();
      
      // Managers and admins can create and update budget categories
      allow create, update: if isManager() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // Only admins can delete budget categories
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Budget Category Masters collection - TEMPORARILY RELAXED FOR DEVELOPMENT
    match /budgetCategoryMasters/{categoryMasterId} {
      // Anyone authenticated can read budget category masters
      allow read: if isAuthenticated();
      
      // DEVELOPMENT: Allow any authenticated user to create and update category masters
      allow create, update: if isAuthenticated();
      
      // Managers and admins can delete category masters
      allow delete: if isManager() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Expenses collection
    match /expenses/{expenseId} {
      // Only admins and managers can read expenses
      allow read: if canManage();
      
      // Only admins and managers can create and update expenses
      allow create, update: if canManage();
      
      // Only admins and managers can delete expenses
      allow delete: if canManage();
    }
    
    // Flats collection
    match /flats/{flatId} {
      // Admins and managers can read all flats
      // Residents can only read their own flat
      allow read: if isAuthenticated() && (
        canManage() ||
        (isResident() && flatId == get(/databases/$(database)/documents/people/$(request.auth.uid)).data.flatId)
      );
      
      // Only admins and managers can create and update flats
      allow create, update: if canManage();
      
      // Only admins and managers can delete flats
      allow delete: if canManage();
    }
    
    // Service Charge Demands collection
    match /serviceChargeDemands/{demandId} {
      // TEMPORARILY RELAXED: Allow all authenticated users to read demands
      // TODO: Implement proper flat-based filtering for residents in production
      allow read: if isAuthenticated();
      
      // Only admins and managers can create and update service charge demands
      allow create, update: if canManage();
      
      // Only admins and managers can delete service charge demands
      allow delete: if canManage();
    }
    
    // Invoices collection
    match /invoices/{invoiceId} {
      // Anyone authenticated can read invoices
      allow read: if isAuthenticated();
      
      // Managers and finance users can create and update invoices
      allow create, update: if isManager() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'finance');
      
      // Only admins can delete invoices
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Buildings collection - TEMPORARILY RELAXED FOR DEVELOPMENT
    match /buildings/{buildingId} {
      // Anyone authenticated can read buildings
      allow read: if isAuthenticated();
      
      // Anyone authenticated can create and update buildings for development
      allow create, update: if isAuthenticated();
      
      // Managers and admins can delete buildings
      allow delete: if isManager() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Assets collection
    match /assets/{assetId} {
      // Anyone authenticated can read assets
      allow read: if isAuthenticated();
      
      // Managers and admins can create and update assets
      allow create, update: if isManager() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // Only admins can delete assets
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Meters collection
    match /meters/{meterId} {
      // Anyone authenticated can read meters
      allow read: if isAuthenticated();
      
      // Managers and admins can create and update meters
      allow create, update: if isManager() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // Only admins can delete meters
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Income collection - TEMPORARILY RELAXED FOR TESTING
    match /income/{incomeId} {
      // Anyone authenticated can read income entries
      allow read: if isAuthenticated();
      
      // Managers and finance users can create and update income entries
      allow create, update: if isManager() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'finance');
      
      // TESTING: Allow managers and admins to delete income entries for data cleanup
      allow delete: if isManager() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Email logs collection - NEW
    match /emailLogs/{emailLogId} {
      // Anyone authenticated can read email logs
      allow read: if isAuthenticated();
      
      // Anyone authenticated can create email logs (for development)
      allow create: if isAuthenticated();
      
      // Managers can update and delete email logs
      allow update, delete: if isManager();
    }
    
    // Work orders collection - NEW
    match /workOrders/{workOrderId} {
      // Anyone authenticated can read work orders
      allow read: if isAuthenticated();
      
      // Anyone authenticated can create and update work orders (for development)
      allow create, update: if isAuthenticated();
      
      // Managers can delete work orders
      allow delete: if isManager();
    }
    
    // Expenditure collection - NEW
    match /expenditure/{expenditureId} {
      // Anyone authenticated can read expenditure entries
      allow read: if isAuthenticated();
      
      // Managers and finance users can create and update expenditure entries
      allow create, update: if isManager() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'finance');
      
      // Only admins can delete expenditure entries
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    
    // Reminders collection - NEW
    match /reminders/{reminderId} {
      // Anyone authenticated can read reminders
      allow read: if isAuthenticated();
      
      // Managers and finance users can create and update reminders
      allow create, update: if isManager() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'finance');
      
      // Only admins can delete reminders
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    
    
    // People collection - TEMPORARILY RELAXED FOR DEVELOPMENT
    match /people/{personId} {
      // Anyone authenticated can read people
      allow read: if isAuthenticated();
      
      // DEVELOPMENT: Allow any authenticated user to create and update people
      allow create, update: if isAuthenticated();
      
      // Only managers can delete people
      allow delete: if isManager();
    }
    
    // Flat Ledger Transactions collection - TEMPORARILY RELAXED FOR DEVELOPMENT
    match /flatLedgerTransactions/{transactionId} {
      // Anyone authenticated can read, create, and update flat ledger transactions
      allow read, create, update: if isAuthenticated();
      
      // Managers and admins can delete flat ledger transactions (for backfill utility)
      allow delete: if isManager() || (isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Resident Account Ledgers collection - TEMPORARILY RELAXED FOR DEVELOPMENT
    match /residentAccountLedgers/{ledgerId} {
      // Anyone authenticated can read, create, and update resident account ledgers
      allow read, create, update: if isAuthenticated();
      
      // Only admins can delete resident account ledgers
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Account Transactions collection - TEMPORARILY RELAXED FOR DEVELOPMENT
    match /accountTransactions/{transactionId} {
      // Anyone authenticated can read, create, and update account transactions
      allow read, create, update: if isAuthenticated();
      
      // Only admins can delete account transactions
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Invitations collection - for user invitation system
    match /invitations/{invitationId} {
      // Admins and managers can create and read all invitations
      allow create: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager');
      
      // Allow public read access for invitations (for acceptance page)
      // Note: This is safe because token is cryptographically secure and single-use
      allow read: if true;
      
      // Allow public update for accepting invitations (marking as accepted)
      // This is safe because:
      // 1. User must know the secure token to find the invitation
      // 2. Invitation can only be accepted once (status change to 'accepted')
      // 3. User account creation is handled by Firebase Auth which is secure
      allow update: if true;
      
      // Only admins can delete invitations
      allow delete: if isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Test collection (for Firebase connection testing)
    match /test/{testId} {
      // Anyone authenticated can read and write test documents
      allow read, write: if isAuthenticated();
    }
  }
}
